<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>maven-parent-pom</artifactId>
    <groupId>io.meeds</groupId>
    <version>29-M01</version>
    <relativePath />
  </parent>
  <groupId>io.meeds.addons</groupId>
  <artifactId>addons-parent-pom</artifactId>
  <version>20-exo-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Meeds AddOns Parent POM</name>
  <description>Maven Parent POM for eXo AddOns projects</description>
  <scm>
    <connection>scm:git:git://github.com/Meeds-io/addons-parent-pom.git</connection>
    <developerConnection>scm:git:git@github.com:Meeds-io/addons-parent-pom.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/Meeds-io/addons-parent-pom</url>
  </scm>
  <issueManagement>
    <system>github</system>
    <url>https://github.com/Meeds-io/addons-parent-pom/issues</url>
  </issueManagement>
  <properties>
    <!-- **************************************** -->
    <!-- Jenkins Settings -->
    <!-- **************************************** -->
    <jenkins.job.name>addons-parent-pom-master-ci</jenkins.job.name>
    <!-- **************************************** -->
    <!-- Repositories URLs                        -->
    <!-- Using DAV for large artifacts - PAR-156  -->
    <!-- **************************************** -->
    <exo.snapshots.repo.url>https://repository.exoplatform.org/content/repositories/meeds-snapshots</exo.snapshots.repo.url>
  </properties>

  <profiles>
    <profile>
      <activation>
        <property>
          <name>packaging</name>
          <value>jar</value>
        </property>
        <file>
          <missing>src/main/resources/no-aop</missing>
        </file>
      </activation>
      <dependencies>
        <dependency>
          <groupId>io.meeds.social</groupId>
          <artifactId>social-component-api</artifactId>
          <scope>provided</scope>
        </dependency>
      </dependencies>
      <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>aspectj-maven-plugin</artifactId>
            <configuration>
              <aspectLibraries>
                <aspectLibrary>
                  <groupId>io.meeds.portal</groupId>
                  <artifactId>portal.component.common</artifactId>
                </aspectLibrary>
                <aspectLibrary>
                  <groupId>io.meeds.social</groupId>
                  <artifactId>social-component-api</artifactId>
                </aspectLibrary>
              </aspectLibraries>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
